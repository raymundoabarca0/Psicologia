# Copia a .env en la raíz de trading_bot/ y rellena. NUNCA subas .env a git.
# Keys con permiso de TRADING pero SIN permiso de RETIRO, restringidas por IP.

# Testnet (modo paper): https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Real (solo se usan si live_trading: true Y LIVE_TRADING=true)
BINANCE_API_KEY=
BINANCE_API_SECRET=
LIVE_TRADING=false

# Alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
